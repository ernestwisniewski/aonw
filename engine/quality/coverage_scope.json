{
  "tool": {
    "name": "cargo-llvm-cov",
    "version": "0.9.0",
    "source": "https://crates.io/crates/cargo-llvm-cov/0.9.0"
  },
  "groups": {
    "authoritative": [
      "aonw_content",
      "aonw_contract_mapping",
      "aonw_contracts",
      "aonw_domain",
      "aonw_engine"
    ],
    "runtime": [
      "aonw_local_runtime"
    ],
    "adapters": [
      "aonw_flutter",
      "aonw_godot"
    ],
    "authoring": [
      "aonw_map_authoring",
      "aonw_map_compiler",
      "aonw_map_compiler_cli",
      "aonw_map_workbench"
    ],
    "testkit": [
      "aonw_testkit"
    ]
  },
  "instrumentedGroups": [
    "authoritative",
    "runtime"
  ],
  "permittedDependencyCoverageGroups": [
    "testkit"
  ],
  "sourceRoot": "src",
  "exclusions": {
    "testAndSupport": [
      "**/tests.rs",
      "**/tests/**"
    ],
    "generated": [],
    "platform": []
  }
}
