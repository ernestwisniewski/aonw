{
	admin off
}

{$AONW_API_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@serverpodWeb path /auth/* /api/stats
	reverse_proxy @serverpodWeb {$AONW_WEB_UPSTREAM}

	reverse_proxy {$AONW_UPSTREAM}
}

{$AONW_INSIGHTS_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	reverse_proxy {$AONW_INSIGHTS_UPSTREAM}
}

{$AONW_HOMEPAGE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@homepageHtml {
		path / /index.html /privacy-policy /privacy-policy/ /privacy-policy/index.html /stats /stats/ /stats/index.html
	}
	header @homepageHtml {
		Cache-Control "no-cache, must-revalidate"
		Content-Type "text/html; charset=utf-8"
	}

	@homepageDownloads {
		path /download/*
	}
	header @homepageDownloads {
		Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate"
		Cloudflare-CDN-Cache-Control "public, max-age=3600"
	}

	redir /privacy-policy/ /privacy-policy 308
	redir /stats/ /stats 308

	@homepageStatsApi path /api/stats
	handle @homepageStatsApi {
		reverse_proxy {$AONW_WEB_UPSTREAM}
	}

	handle {
		header {
			?Cache-Control "public, max-age=86400"
		}
		root * /srv/homepage
		try_files {path} {path}/index.html
		file_server
	}
}

{$AONW_DEMO_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@demoRuntime {
		path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /main.dart.js /main.dart.mjs /main.dart.wasm /version.json /manifest.json
	}
	header @demoRuntime {
		Cache-Control "no-cache, must-revalidate"
		Cloudflare-CDN-Cache-Control "no-cache"
	}

	@demoAssets {
		path /assets/* /canvaskit/* /icons/*
	}
	header @demoAssets {
		Cache-Control "public, max-age=3600, must-revalidate"
		Cloudflare-CDN-Cache-Control "public, max-age=3600"
	}

	root * /srv/demo
	try_files {path} /index.html
	file_server
}
