[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../../engine/target/debug/libaonw_godot.so"
linux.release.x86_64 = "res://../../engine/target/release/libaonw_godot.so"
windows.debug.x86_64 = "res://../../engine/target/debug/aonw_godot.dll"
windows.release.x86_64 = "res://../../engine/target/release/aonw_godot.dll"
macos.debug = "res://../../engine/target/debug/libaonw_godot.dylib"
macos.release = "res://../../engine/target/release/libaonw_godot.dylib"
macos.debug.arm64 = "res://../../engine/target/debug/libaonw_godot.dylib"
macos.release.arm64 = "res://../../engine/target/release/libaonw_godot.dylib"
