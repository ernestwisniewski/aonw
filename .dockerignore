# Default-deny the remote build context. Add new compiler or runtime inputs
# explicitly and keep tool/check_docker_context.sh green.
**

# Server compiler and runtime inputs.
!server/
server/**
!server/pubspec.yaml
!server/pubspec.lock
!server/bin/
!server/bin/**
!server/lib/
!server/lib/**
!server/config/
server/config/**
!server/config/development.yaml
!server/config/staging.yaml
!server/config/production.yaml
!server/config/test.yaml
!server/migrations/
!server/migrations/**
!server/docker-entrypoint.sh

# Shared Dart-only domain package.
!packages/
packages/**
!packages/aonw_core/
packages/aonw_core/**
!packages/aonw_core/pubspec.yaml
!packages/aonw_core/pubspec.lock
!packages/aonw_core/lib/
!packages/aonw_core/lib/**

# Runtime map data.
!assets/
assets/**
!assets/maps/
!assets/maps/**

# Serverpod migrations are the only plain SQL inputs allowed in the image.
**/*.sql
!server/migrations/*/definition.sql
!server/migrations/*/migration.sql

# Defense in depth. These rules stay after every allow rule so local files are
# never sent to a remote builder or retained in its cache. Directory rules also
# match their contents to override the narrow migration exceptions above.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/*.envrc
**/.direnv/
**/.direnv/**
**/*.log
**/.DS_Store
**/passwords*.yaml
**/passwords*.yml
**/.ssh/
**/.ssh/**
**/.aws/
**/.aws/**
**/id_rsa*
**/id_ed25519*
**/id_dsa*
**/id_ecdsa*
**/authorized_keys
**/known_hosts
**/key.properties
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.ppk
**/*.pkcs8
**/*.pkcs12
**/*.p7b
**/*.p7c
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.provisionprofile
**/*.crt
**/*.cer
**/*.der
**/*.csr
**/certs/
**/certs/**
**/certificates/
**/certificates/**
**/*credentials*.json
**/*credentials*.yaml
**/*credentials*.yml
**/*service-account*.json
**/*service-account*.yaml
**/*service-account*.yml
**/*service_account*.json
**/*service_account*.yaml
**/*service_account*.yml
**/client_secret*.json
**/google-services.json
**/GoogleService-Info.plist
**/backup/
**/backup/**
**/backups/
**/backups/**
**/*.bak
**/*.backup
**/*.backup.*
**/*.dump
**/*.dump.*
**/*.dmp
**/*.dmp.*
**/*.pgdump
**/*.pgdump.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.7z
**/*.rar
**/*.sql.*
